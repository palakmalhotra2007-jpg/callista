PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Firebase Configuration
# Option 1 (Recommended): Download serviceAccountKey.json from Firebase Console
# Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2 (Alternative for cloud environments):
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: MongoDB URI for data migration (npm run migrate:firebase)
MONGO_URI=mongodb+srv://...
