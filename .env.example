PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# ─────────────────────────────────────────────────────────────
# Firebase Configuration
# ─────────────────────────────────────────────────────────────
# LOCAL DEV (Option 1 — Recommended):
#   Place your serviceAccountKey.json in the project root and set:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# PRODUCTION / VERCEL (Option 2 — Required when file can't be deployed):
#   Set these three variables in your hosting dashboard instead.
#   Get them from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
#
# FIREBASE_PROJECT_ID=callista-43608
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@callista-43608.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# ⚠️  FIREBASE_PRIVATE_KEY must be wrapped in double quotes.
#     Keep the literal \n characters — do NOT replace them with real newlines.
# ─────────────────────────────────────────────────────────────

# Optional: MongoDB URI (only needed for npm run migrate:firebase)
# MONGO_URI=mongodb+srv://...
